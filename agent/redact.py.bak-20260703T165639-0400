"""Compatibility redaction helpers for Hermes tools.

This module intentionally keeps the public API broad because tool entrypoints from
nearby Hermes versions call these helpers with slightly different keyword
arguments.  The helpers below redact common secret-looking values while accepting
extra options without failing.
"""
from __future__ import annotations

import re
from typing import Any

_SECRET_PATTERNS = [
    re.compile(r"(?i)(api[_-]?key|token|secret|password|passwd|authorization|bearer)\s*[:=]\s*([^\s'\"`]+)"),
    re.compile(r"(?i)(sk-[A-Za-z0-9_\-]{20,})"),
    re.compile(r"(?i)(ghp_[A-Za-z0-9_]{20,})"),
    re.compile(r"(?i)(xox[baprs]-[A-Za-z0-9\-]{20,})"),
    re.compile(r"(?i)(AKIA[0-9A-Z]{16})"),
]


def _to_text(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def redact_sensitive_text(text: Any, *args: Any, **kwargs: Any) -> str:
    """Return text with common credential material redacted.

    Accepts arbitrary positional/keyword arguments for compatibility with older
    and newer Hermes tool call sites (for example: file_read=True).
    """
    out = _to_text(text)
    for pat in _SECRET_PATTERNS:
        def repl(match: re.Match[str]) -> str:
            if len(match.groups()) >= 2:
                return f"{match.group(1)}=<REDACTED>"
            return "<REDACTED>"
        out = pat.sub(repl, out)
    return out


def redact_terminal_output(text: Any, *args: Any, **kwargs: Any) -> str:
    """Compatibility wrapper used by terminal_tool."""
    return redact_sensitive_text(text, *args, **kwargs)


def redact_file_output(text: Any, *args: Any, **kwargs: Any) -> str:
    """Compatibility wrapper used by file tools in some Hermes builds."""
    return redact_sensitive_text(text, *args, **kwargs)


def redact_json(obj: Any, *args: Any, **kwargs: Any) -> Any:
    """Best-effort recursive redaction for JSON-like objects."""
    if isinstance(obj, str):
        return redact_sensitive_text(obj, *args, **kwargs)
    if isinstance(obj, list):
        return [redact_json(x, *args, **kwargs) for x in obj]
    if isinstance(obj, tuple):
        return tuple(redact_json(x, *args, **kwargs) for x in obj)
    if isinstance(obj, dict):
        redacted = {}
        for k, v in obj.items():
            if re.search(r"(?i)(api[_-]?key|token|secret|password|passwd|authorization|bearer)", str(k)):
                redacted[k] = "<REDACTED>"
            else:
                redacted[k] = redact_json(v, *args, **kwargs)
        return redacted
    return obj
